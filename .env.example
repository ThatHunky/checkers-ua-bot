# Copy to .env and fill in. .env is git-ignored and excluded from the image
# (.dockerignore) -- it is supplied to the container at runtime via env_file.

# ---- Required ----
# Telegram bot token from @BotFather
TOKEN=your_telegram_bot_token

# ---- Mode ----
# true  -> webhook mode (production; binds PORT, needs a reverse proxy for TLS)
# false -> long polling (development; binds nothing)
USE_WEBHOOK=false

# ---- Webhook Configuration (only used when USE_WEBHOOK=true) ----
PORT=8787
WEBHOOK_LISTEN=0.0.0.0
WEBHOOK_URL=https://checkers.dobrovolskyi.com.ua

# Optional. Left unset, both are derived deterministically from TOKEN (SHA-256), so
# the URL is stable across restarts with no extra config and the token never appears
# in a URL, a log line or a proxy access log. Rotating TOKEN therefore also rotates
# the path and the secret; set them explicitly to pin them independently.
# WEBHOOK_PATH=
# WEBHOOK_SECRET=

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Databases (paths inside the container; /data is a host volume) ----
DB_PATH=/data/ratings.db
GAMEDATA_DB_PATH=/data/gamedata.db

# ---- Gameplay ----
# Minutes of inactivity before a game is timed out
GAME_TIMEOUT_MINUTES=10

# ---- Admin ----
# Telegram user id allowed to run the hidden admin commands
ADMIN_ID=
